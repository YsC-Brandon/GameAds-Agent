# Only reviewed public documentation is eligible. Artwork has unresolved provenance.
/docs/*
!/docs/release-status.md
!/docs/dependency-licenses.md
!/docs/generated/
/docs/assets/
/docs/archive/
/docs/contracts/
/GameAds-Agent_Cline_*.md
/Dockerfile
/.dockerignore

# Internal evidence verification requires private contracts/history; keep it local.
/scripts/*
!/scripts/check_public.ps1
!/scripts/verify_public_openapi.py
!/scripts/generate_demo_data.py
!/scripts/verify_installed_runtime.py
!/scripts/verify_isolated_install.py
!/scripts/run_recorded.py

