# Deterministic tools and HTTP health/data routes work without an LLM key.
GAMEADS_ENV=development
GAMEADS_LOG_LEVEL=INFO

# Phase 2: OpenAI-compatible chat/completions API. Use your provider's /v1 URL.
# Keep the key blank until needed; never commit a populated .env.
GAMEADS_LLM_BASE_URL=https://api.openai.com/v1
GAMEADS_LLM_MODEL=
GAMEADS_LLM_API_KEY=
GAMEADS_LLM_TIMEOUT_SECONDS=30
GAMEADS_AGENT_MAX_ROUNDS=6
GAMEADS_AGENT_MAX_TOOL_CALLS=12
GAMEADS_AGENT_MAX_CONTEXT_BYTES=500000

# Illustrative heuristic thresholds, not validated business recommendations.
# Fractions: 0.30 means 30%; strict inequalities trigger alerts.
GAMEADS_ANOMALY__CTR_DROP_FRACTION=0.30
GAMEADS_ANOMALY__CPA_INCREASE_FRACTION=0.30
GAMEADS_ANOMALY__ROAS_FLOOR=1.0
GAMEADS_ANOMALY__MIN_IMPRESSIONS=1000
GAMEADS_ANOMALY__MIN_CLICKS=30
GAMEADS_ANOMALY__MIN_CONVERSIONS=5